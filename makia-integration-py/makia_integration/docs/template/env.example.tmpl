# Copy to .env (or /etc/makia-integration.env) and fill in. Keep the real file private:
#   chown root:makia-integration /etc/makia-integration.env && chmod 640 /etc/makia-integration.env
# Lines are KEY=VALUE. A line starting with # is ignored. No quotes needed.

# Address of MAKIA, for example https://makia.your-company.example
MAKIA_API_URL=

# Token of the sync account (creates and updates projects and members).
MAKIA_SYNC_TOKEN=

# Token of the run account (sends records, reads results).
MAKIA_RUN_TOKEN=

# Set exactly ONE of the next two (send, run and listen stop with exit code 2 when both
# or neither are set).
# Send files by reference: the id of the storage connection MAKIA reads them from.
# MAKIA_STORAGE_CONNECTION_ID=

# Send files by upload: a folder on this server. Record file paths are relative to it.
# MAKIA_FILES_DIR=/srv/makia-files

# The integration's own state file (default makia-state.db beside where it runs).
# One process per state file. Never delete it while the integration runs.
# MAKIA_STATE_FILE=/var/lib/makia-integration/makia-state.db

# PEM file with your organization's CA, if MAKIA uses a private certificate (or the
# makia-server-cert.pem `doctor` saved, once you checked its fingerprint).
# By default the system certificate store is used.
# MAKIA_CA_BUNDLE=/etc/ssl/certs/company-ca.pem

# Where the integration lives: module:function. The generated service uses integration:integration.
# MAKIA_INTEGRATION=integration:integration

# Secret of the webhook (shown once by `makia-integration webhook create`).
# Required for `run --listen` and `listen`: without it they stop with exit code 2.
# MAKIA_WEBHOOK_SECRET=
